{
  "manifest_version": 3,
  "name": "Maximize Video - 视频网页全屏",
  "version": "12.0.0",
  "description": "在视频右上角添加「网页全屏」和「画中画」按钮。ESC 退出全屏，F2 触发画中画。",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://www.w3school.com.cn/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
